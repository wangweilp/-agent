# =============================================================================
# Sandbox v2 Environment Variable Template
# =============================================================================
# 本文件是 Sandbox v2 生产化配置的参考模板。
# 默认所有危险能力安全关闭。复制为 .env.sandbox-v2 并修改后使用。
#
# ⚠️  重要：本模板默认值严格遵循 fail-closed 原则。
#     不要将此模板视为"推荐默认开放"的配置。
#     每个危险能力的开启都需要逐项审计和批准。
# =============================================================================

# ── Sandbox v2 Core ──────────────────────────────────────────────────────────

# 是否启用 Sandbox v2 模块 (true/false)
SANDBOX_V2_ENABLED=true

# 运行模式：simulation | trusted_fixture | metadata_only
# simulation: 不执行任何真实代码
# trusted_fixture: 仅执行预先审查的 fixture
# metadata_only: 仅返回元数据，不执行
SANDBOX_V2_MODE=simulation

# 默认策略动作：deny | allow
# 生产环境必须为 deny
SANDBOX_V2_DEFAULT_ACTION=deny

# Fail-closed 模式：任何异常或未知输入 → deny
# 生产环境必须为 true
SANDBOX_V2_FAIL_CLOSED=true

# ── Artifact ─────────────────────────────────────────────────────────────────

# Artifact 存储根目录
SANDBOX_V2_ARTIFACT_ROOT=.sandbox_v2_artifacts

# 单个 artifact 最大字节数 (默认 1MB)
SANDBOX_V2_MAX_ARTIFACT_BYTES=1048576

# 单个 job 所有 artifact 最大总字节数 (默认 10MB)
SANDBOX_V2_MAX_JOB_ARTIFACT_BYTES=10485760

# Artifact 只读物化要求 (true/false)
# true: artifact 只能被读取，不可被写入/覆盖
SANDBOX_V2_READ_ONLY_ARTIFACTS=true

# ── Package Quarantine ───────────────────────────────────────────────────────

# Package 隔离区根目录
SANDBOX_V2_PACKAGE_QUARANTINE_ROOT=.sandbox_v2_package_quarantine

# 是否允许任何包下载 (true/false)
# ⚠️ 生产环境必须为 false，除非经过逐项审计和批准
SANDBOX_V2_PACKAGE_DOWNLOAD_ENABLED=false

# 是否允许从公共 registry (PyPI/npm/Maven) 下载 (true/false)
SANDBOX_V2_PUBLIC_REGISTRY_ENABLED=false

# 是否允许包安装 (true/false)
# 即使下载了包，安装也是独立的危险能力
SANDBOX_V2_PACKAGE_INSTALLATION_ENABLED=false

# 是否强制要求提供包哈希 (sha256) (true/false)
SANDBOX_V2_REQUIRE_PACKAGE_HASH=true

# 是否强制要求提供包签名 (true/false)
SANDBOX_V2_REQUIRE_PACKAGE_SIGNATURE=true

# 是否强制要求提供 SBOM (true/false)
SANDBOX_V2_REQUIRE_SBOM=true

# ── Network ──────────────────────────────────────────────────────────────────

# 是否允许任何网络出站 (true/false)
# ⚠️ 生产环境必须为 false，除非经过逐项审计和批准
SANDBOX_V2_NETWORK_ENABLED=false

# 网络模式：preflight_only | allow_all | deny_all
# preflight_only: 仅做策略检查，不做真实网络请求
SANDBOX_V2_NETWORK_PREFLIGHT_ONLY=true

# 是否阻止私有网络地址 (10.x, 172.16-31.x, 192.168.x) (true/false)
SANDBOX_V2_BLOCK_PRIVATE_NETWORKS=true

# 是否阻止云 metadata 服务 (169.254.169.254, metadata.google.internal) (true/false)
SANDBOX_V2_BLOCK_METADATA_SERVICE=true

# 允许的域名白名单（逗号分隔，空=全部拒绝）
SANDBOX_V2_ALLOWED_DOMAINS=

# 拒绝的域名黑名单（逗号分隔）
SANDBOX_V2_DENIED_DOMAINS=localhost,127.0.0.1,169.254.169.254

# ── Container ────────────────────────────────────────────────────────────────

# 是否启用真实容器执行 (true/false)
# ⚠️ 这是最高风险开关之一。仅在 Linux + 完整安全审查后开启。
# 开启前必须先通过所有 red-team tests、完成容器逃逸测试、
# 验证 rootless 配置、验证 seccomp/AppArmor/SELinux。
SANDBOX_V2_CONTAINER_EXECUTION_ENABLED=false

# 是否运行真实容器集成测试 (true/false)
# 仅在 Linux + container_execution_enabled=true 时有效
SANDBOX_V2_RUN_CONTAINER_INTEGRATION=false

# 允许的容器镜像白名单（逗号分隔）
# 默认仅允许 minimal alpine Python 和 busybox
SANDBOX_V2_ALLOWED_IMAGES=python:3.11-alpine,busybox:latest

# 是否自动 pull 镜像 (true/false)
# ⚠️ 生产环境必须为 false。镜像必须在部署前手动 pull 并审计。
SANDBOX_V2_AUTO_PULL_IMAGES=false

# 是否允许用户自定义命令执行 (true/false)
# ⚠️ 这是最高风险开关之一。true 意味着用户可以指定任意容器命令。
SANDBOX_V2_USER_COMMAND_EXECUTION=false

# 是否允许用户指定容器镜像 (true/false)
# ⚠️ 这是最高风险开关之一。true 意味着用户可以 pull 任意镜像。
SANDBOX_V2_USER_IMAGE_EXECUTION=false

# ── Kill Switch ──────────────────────────────────────────────────────────────

# 是否启用 Kill Switch 统一控制 (true/false)
SANDBOX_V2_KILL_SWITCH_ENABLED=true

# 是否允许 kill 任意系统 PID (true/false)
# ⚠️ 生产环境必须为 false。只允许 kill sandbox 管理的对象。
SANDBOX_V2_ARBITRARY_PID_KILL=false

# 是否允许真实容器 kill (true/false)
# 仅在 Linux + container_execution_enabled=true 时有效
SANDBOX_V2_CONTAINER_KILL_ENABLED=false

# ── Queue / Worker ───────────────────────────────────────────────────────────

# 队列后端：sqlite | redis | celery
# 当前默认 sqlite 用于本地开发
SANDBOX_V2_QUEUE_BACKEND=sqlite

# 是否启用 Worker 轮询 (true/false)
SANDBOX_V2_WORKER_ENABLED=true

# Worker 最大重试次数
SANDBOX_V2_WORKER_MAX_ATTEMPTS=3

# Worker lease 超时秒数
SANDBOX_V2_WORKER_LEASE_SECONDS=60

# ── MicroVM / Firecracker (Step 11) ──────────────────────────────────────────
# ⚠️ 默认全部安全关闭。仅 Linux+KVM+Firecracker+kernel+rootfs+env var 可开启。
SANDBOX_V2_MICROVM_EXECUTION_ENABLED=false
SANDBOX_V2_RUN_MICROVM_INTEGRATION=false
SANDBOX_V2_FIRECRACKER_BIN_PATH=
SANDBOX_V2_FIRECRACKER_KERNEL_PATH=
SANDBOX_V2_FIRECRACKER_ROOTFS_PATH=
SANDBOX_V2_FIRECRACKER_JAILER_ENABLED=false
SANDBOX_V2_MICROVM_NETWORK_ENABLED=false
SANDBOX_V2_MICROVM_MAX_MEMORY_MB=128
SANDBOX_V2_MICROVM_VCPU_COUNT=1
SANDBOX_V2_MICROVM_TIMEOUT_SECONDS=10
SANDBOX_V2_MICROVM_ALLOW_USER_KERNEL=false
SANDBOX_V2_MICROVM_ALLOW_USER_ROOTFS=false
SANDBOX_V2_MICROVM_ALLOW_HOST_MOUNTS=false

# ── Future Production Backends ───────────────────────────────────────────────
# 以下配置为未来生产迁移预留，当前不生效。
# 当前代码默认使用 SQLite + local storage。

# 数据库后端：sqlite | postgres
# ── Future Production Backends ───────────────────────────────────────────────
# 以下配置为未来生产迁移预留，当前不生效。
# 当前代码默认使用 SQLite + local storage。
# ⚠️ 如果显式选择 postgres/redis/minio 但缺 DSN/URL/credentials，
#    系统会 fail closed（返回 blocker），不会静默回退到 SQLite/local。

# ── Backend Integration (Step 13) ──
# 真实后端集成测试开关。必须设为 true 才运行真实连接测试。
# 普通 pytest 不依赖外部服务。
SANDBOX_V2_RUN_BACKEND_INTEGRATION=false

# 数据库后端：sqlite | postgres
SANDBOX_V2_DATABASE_BACKEND=sqlite

# PostgreSQL DSN（仅 database_backend=postgres 时需要）
# 格式: postgresql://user:password@host:5432/sandbox_v2
SANDBOX_V2_POSTGRES_DSN=

# Redis URL（用于队列和缓存）
# 格式: redis://localhost:6379/0
# 仅 queue_backend=redis 时需要
SANDBOX_V2_REDIS_URL=

# 对象存储后端：local | s3 | minio
SANDBOX_V2_OBJECT_STORAGE_BACKEND=local

# MinIO Endpoint（仅 object_storage_backend=minio 时需要）
# 格式: http://localhost:9000
SANDBOX_V2_MINIO_ENDPOINT=

# MinIO Access Key
SANDBOX_V2_MINIO_ACCESS_KEY=

# MinIO Secret Key
SANDBOX_V2_MINIO_SECRET_KEY=

# MinIO Bucket
SANDBOX_V2_MINIO_BUCKET=sandbox-v2-artifacts

# S3 Access Key
SANDBOX_V2_S3_ACCESS_KEY=

# S3 Secret Key
SANDBOX_V2_S3_SECRET_KEY=

# S3 Bucket
SANDBOX_V2_S3_BUCKET=sandbox-v2-artifacts

# S3 Region
SANDBOX_V2_S3_REGION=us-east-1

# Object key prefix (用于组织不同环境/项目的 object key)
# e.g. sandbox-v2/prod
SANDBOX_V2_STORAGE_PREFIX=

# ── Observability (Step 18) ────────────────────────────────────────────────────
# Prometheus / Grafana / OpenTelemetry 集成基础。默认不发送外部 telemetry。

# 是否启用 observability 模块 (true/false)
SANDBOX_V2_OBSERVABILITY_ENABLED=false

# 是否启用 Prometheus metrics 导出 (仅本地文本 endpoint)
SANDBOX_V2_PROMETHEUS_EXPORT_ENABLED=true

# Prometheus scrape path
SANDBOX_V2_PROMETHEUS_SCRAPE_PATH=/api/runtime/sandbox-v2/monitoring/metrics/prometheus

# 是否启用 Grafana dashboard 生成 (true/false)
SANDBOX_V2_GRAFANA_DASHBOARD_ENABLED=false

# OpenTelemetry 设置 (默认完全关闭)
SANDBOX_V2_OTEL_ENABLED=false
SANDBOX_V2_OTEL_EXPORTER=disabled
SANDBOX_V2_OTEL_ENDPOINT=
SANDBOX_V2_OTEL_SERVICE_NAME=sandbox-v2
SANDBOX_V2_OTEL_TRACES_ENABLED=false
SANDBOX_V2_OTEL_METRICS_ENABLED=false
SANDBOX_V2_OTEL_LOGS_ENABLED=false
SANDBOX_V2_OTEL_EXPORT_INTERVAL_SECONDS=60
SANDBOX_V2_OTEL_INCLUDE_SENSITIVE_ATTRIBUTES=false

# Observability 安全模式
SANDBOX_V2_OBSERVABILITY_SAFE_MODE=true

# 是否运行 observability 集成测试 (true/false)
SANDBOX_V2_RUN_OBSERVABILITY_INTEGRATION=false

# ── IAM / SSO (Step 17) ────────────────────────────────────────────────────────
# 外部 IAM / SSO 集成基础。默认完全关闭。
# ⚠️ 本步骤不接入真实 IdP，不做真实 OIDC/SAML 登录。
#     所有 endpoint/claim mapping 仅用于骨架验证和 mock 安全测试。

# 是否启用 IAM 模块 (true/false)
SANDBOX_V2_IAM_ENABLED=false

# 是否启用 SSO 登录 (true/false)
SANDBOX_V2_SSO_ENABLED=false

# IAM Provider 类型：disabled | oidc | saml | mock
# mock 仅用于测试和本地模拟，不连接外网
SANDBOX_V2_IAM_PROVIDER=disabled

# OIDC 配置
SANDBOX_V2_OIDC_ENABLED=false
SANDBOX_V2_OIDC_ISSUER=
SANDBOX_V2_OIDC_CLIENT_ID=
SANDBOX_V2_OIDC_CLIENT_SECRET=
SANDBOX_V2_OIDC_JWKS_URI=
SANDBOX_V2_OIDC_DISCOVERY_ENABLED=false

# SAML 配置
SANDBOX_V2_SAML_ENABLED=false
SANDBOX_V2_SAML_ENTITY_ID=
SANDBOX_V2_SAML_METADATA_PATH=
SANDBOX_V2_SAML_METADATA_URL=
SANDBOX_V2_SAML_METADATA_DOWNLOAD_ENABLED=false

# JIT Provisioning (默认关闭)
SANDBOX_V2_IAM_JIT_PROVISIONING=false

# 默认角色 (viewer | auditor | developer | operator)
# ⚠️ 不能默认为 owner 或 admin
SANDBOX_V2_IAM_DEFAULT_ROLE=viewer

# 允许的 email domain 白名单（逗号分隔，空=全部拒绝）
SANDBOX_V2_IAM_ALLOWED_DOMAINS=

# 是否要求已验证 email (true/false)
SANDBOX_V2_IAM_REQUIRE_VERIFIED_EMAIL=true

# 是否启用外部 group 映射 (true/false)
SANDBOX_V2_IAM_EXTERNAL_GROUP_MAPPING_ENABLED=false

# 是否运行 IAM 集成测试 (true/false)
# ⚠️ 只应在 IAM/SSO 均已启用的安全环境中运行
SANDBOX_V2_RUN_IAM_INTEGRATION=false

# ── Load Testing / SLO (Step 19) ──────────────────────────────────────────────
# 真实 staging / production load test 与 SLO 基线。
# ⚠️ 默认完全关闭。只有显式 env 开启 + staging_base_url 配置后才运行。

# 是否启用 load testing 模块 (true/false)
SANDBOX_V2_LOAD_TESTING_ENABLED=false

# 是否运行真实 staging load test (true/false)
# ⚠️ 设为 true 时会对 STAGING_BASE_URL 发送请求
SANDBOX_V2_RUN_STAGING_LOAD_TEST=false

# Staging 环境 URL（必须显式设置）
SANDBOX_V2_STAGING_BASE_URL=

# Staging 认证模式：none | token | bearer
SANDBOX_V2_STAGING_AUTH_MODE=none

# Staging API token（如果 auth_mode=token）
SANDBOX_V2_STAGING_API_TOKEN=

# Load test profile：smoke | staging_small | staging_medium | production_readonly | custom
SANDBOX_V2_LOAD_TEST_PROFILE=smoke

# 最大并发用户数 (安全上限 10)
SANDBOX_V2_LOAD_TEST_MAX_USERS=5

# 最大每秒请求数 (安全上限 10)
SANDBOX_V2_LOAD_TEST_MAX_RPS=5

# Load test 持续时间 (秒，安全上限 120)
SANDBOX_V2_LOAD_TEST_DURATION_SECONDS=30

# 单请求超时 (秒)
SANDBOX_V2_LOAD_TEST_TIMEOUT_SECONDS=5

# Load test 目标（逗号分隔）
SANDBOX_V2_LOAD_TEST_TARGETS=readiness,metrics,network_preflight

# Load test 报告输出目录
SANDBOX_V2_LOAD_TEST_OUTPUT_DIR=.sandbox_v2_load_reports

# 是否允许对生产 URL 压测 (true/false)
# ⚠️ 生产环境必须为 false
SANDBOX_V2_LOAD_TEST_ALLOW_PRODUCTION=false

# 是否要求人工确认 (true/false)
SANDBOX_V2_LOAD_TEST_REQUIRE_CONFIRMATION=true

# SLO 阈值定义
SANDBOX_V2_SLO_P95_MS=500
SANDBOX_V2_SLO_P99_MS=1500
SANDBOX_V2_SLO_ERROR_RATE_PERCENT=1.0
SANDBOX_V2_SLO_AVAILABILITY_PERCENT=99.0

# ── Performance / Capacity (Step 16) ─────────────────────────────────────────
# 默认关闭，普通 pytest 不会触发大规模压测。
# 仅使用 synthetic fixture，不执行用户代码、不访问外网、不启动容器/MicroVM。
SANDBOX_V2_PERF_TESTS_ENABLED=false
SANDBOX_V2_RUN_PERFORMANCE_BENCHMARKS=false
SANDBOX_V2_PERF_PROFILE=small
SANDBOX_V2_PERF_MAX_JOBS=100
SANDBOX_V2_PERF_MAX_QUEUE_ITEMS=100
SANDBOX_V2_PERF_MAX_ARTIFACTS=50
SANDBOX_V2_PERF_MAX_CONCURRENCY=4
SANDBOX_V2_PERF_TIMEOUT_SECONDS=60
SANDBOX_V2_PERF_CLEANUP_AFTER_RUN=true
SANDBOX_V2_PERF_OUTPUT_DIR=.sandbox_v2_perf_reports
