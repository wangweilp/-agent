# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
# Leave empty in development to auto-generate a temporary key at startup.
# Set a stable random value in production.
JWT_SECRET_KEY=

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db

# SQLite
SQLITE_DB_PATH=./data/agent_memory.db

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Agent Configuration
AGENT_SHORT_TERM_MEMORY_SIZE=20
AGENT_MAX_TOOL_ROUNDS=5

# Super Admin Auto-Create（服务启动时自动创建，已存在则跳过）
# 设置后启动服务即可自动创建超级管理员账号
ADMIN_EMAIL=
ADMIN_PASSWORD=
