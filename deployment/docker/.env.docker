# ============================================================
# Enterprise Knowledge OS — Docker 环境变量配置
# ============================================================
# 使用方式：
#   docker compose --env-file .env.docker up
# 或复制为 .env 使用：
#   cp .env.docker .env && docker compose up
# ============================================================

# ── DeepSeek API 配置 ───────────────────────────────────────
# 【必填】API 密钥，从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-key-here
# API 地址（默认为官方地址；内网部署可替换为代理或私有网关）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（deepseek-chat / deepseek-coder 等）
DEEPSEEK_MODEL=deepseek-chat

# ── 数据持久化 ─────────────────────────────────────────────
# ChromaDB 向量数据库存储路径（容器内路径，映射到宿主机 volume）
CHROMA_PERSIST_DIR=/app/data/chroma_db
# SQLite 关系数据库路径（容器内路径）
SQLITE_DB_PATH=/app/data/agent_memory.db
# 文件上传目录
UPLOAD_DIR=/app/data/uploads
AUDIO_UPLOAD_DIR=/app/data/audio_uploads
VIDEO_UPLOAD_DIR=/app/data/video_uploads

# ── Embedding 模型配置 ──────────────────────────────────────
# 向量化模型（首次使用自动下载；内网部署需预先下载模型）
# 可选模型：BAAI/bge-small-zh-v1.5（轻量中文）/ BAAI/bge-base-zh-v1.5（均衡）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── Agent 行为配置 ──────────────────────────────────────────
AGENT_SHORT_TERM_MEMORY_SIZE=20
AGENT_MAX_TOOL_ROUNDS=5
AGENT_CONTEXT_WINDOW=6

# ── 上传限制 (MB) ──────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=20
AUDIO_MAX_SIZE_MB=50
VIDEO_MAX_SIZE_MB=200
VIDEO_KEYFRAME_INTERVAL=5

# ── 日志级别 ───────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── 运行环境（dev / staging / production）────────────────────
# 设为 production 时，JWT_SECRET_KEY 必须显式设置，否则启动失败
ENVIRONMENT=production

# ── JWT 签名密钥（生产环境务必修改为随机字符串）──────────────
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
